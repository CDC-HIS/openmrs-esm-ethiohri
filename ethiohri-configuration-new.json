          "address",
          "kebela",
          "houseNumber",
          "mobiletelephoneNumber",
          "hometelephoneNumber",
          "worktelephoneNumber"
        ]
      },
      {
        "id": "demographics",
        "name": "Basic Info",
        "fields": [
          "registrationDate",
          "name",
          "gender",
          "dob",
          "id"
        ]
      }
