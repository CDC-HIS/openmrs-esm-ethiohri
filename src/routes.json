{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
   "fhir2": ">=1.2",
    "webservices.rest": ">=2.2.0"
  },
  "pages": [{
      "component": "root",
      "route": "home"
    }],
  "extensions": [
     {
      "name": "template-esm-ext",
      "slot": "patient-chart-dashboard-slot",
      "component": "templateEsmMenu",
      "meta": {
        "slot": "hiv-care-and-treatment-slot",
        "path": "hiv-care-and-treatment",
        "title": "HIV Care & Treatment"
      }
    },
     {
      "name": "home-dashboard-slot",
      "component": "homeLeftPanelLink",
      "slot": "homepage-dashboard-slot",
      "order": 0,
      "meta": {
        "columns": 1,
        "slot": "home-dashboard-slot",
        "name": "home" 
      }
    },
    {
      "name": "home-slot",
      "slot": "home-dashboard-slot",
      "component": "homeDashboard"
    } 
    
  ]
}
