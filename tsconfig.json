{
  "exclude": ["node_modules"],
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "react",
    "lib": [
      "dom",
      "es5",
      "scripthost",
      "es2015",
      "es2015.promise",
      "es2016.array.include",
      "es2018",
      "es2020",
      "es2022"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "noEmit": true,
    "paths": {
      "@openmrs/esm-framework": ["./node_modules/@openmrs/esm-framework/dist/index.d.ts"],
      "@openmrs/esm-framework/*": ["./node_modules/@openmrs/esm-framework/dist/*"], 
      "tools": ["./tools"],
      "tools/*": ["./tools/*"],
      "__mocks__": ["./__mocks__"],
      "__mocks__/*": ["./__mocks__/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "strictNullChecks": false,
    "target": "esnext",
    "typeRoots": ["./node_modules/@types"]
  }
}